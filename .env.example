# Copy this file to .env.local for local testing, and add the same names in
# Vercel → Project → Settings → Environment Variables. See docs/ORDERS_SETUP.md.

# Google Apps Script web app that saves orders to your Google Sheet (SECRET: server only)
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec
SHEETS_SECRET=the-secret-printed-by-the-setup-function

# OPTIONAL. The UPI ID defaults to the one in src/config/upi.ts.
# Only set these to override it (public: it appears on the page).
# NEXT_PUBLIC_UPI_ID=yourname@bank
# NEXT_PUBLIC_UPI_NAME=Your Name
