# Copy this file to .env.local for local testing, and add the same names in
# Vercel → Project → Settings → Environment Variables.

# Your UPI ID and the name shown to the payer (public: it appears on the page)
NEXT_PUBLIC_UPI_ID=yourname@bank
NEXT_PUBLIC_UPI_NAME=Chillcom

# Supabase (SECRET: server only, never prefix with NEXT_PUBLIC_)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
